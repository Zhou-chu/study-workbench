# Names/placeholders only. Do not use as runtime configuration.
# Have the user approve credential generation, store actual values outside source,
# restrict config to0600, and launch with scripts/v1/run_native.py --config PATH.
OPEN_NOTEBOOK_PASSWORD=
OPEN_NOTEBOOK_ENCRYPTION_KEY=
SURREAL_PASSWORD=
SURREAL_USER=root
SURREAL_URL=ws://127.0.0.1:18000/rpc
SURREAL_NAMESPACE=study_workbench
SURREAL_DATABASE=study_workbench
STUDY_WORKBENCH_DATA_DIR=
STUDY_WORKBENCH_RUNTIME_DIR=
# Optional; defaults to runtime/upstream-data in the native launcher.
OPEN_NOTEBOOK_DATA_DIR=
# Only configure after the application's Google sign-in has been authorized.
NOTEBOOKLM_STORAGE_PATH=
INTERNAL_API_URL=http://127.0.0.1:5055
API_URL=http://127.0.0.1:13000
CORS_ORIGINS=http://127.0.0.1:13000
STUDY_WORKBENCH_MAX_FILE_MB=50
STUDY_WORKBENCH_MAX_PDF_PAGES=300
STUDY_WORKBENCH_EXTRACT_TIMEOUT_SECONDS=30
STUDY_WORKBENCH_EXTRACT_CONCURRENCY=2
