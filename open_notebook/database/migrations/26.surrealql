-- StudyWorkbench V1: existing SurrealDB, no new database service.
DEFINE TABLE IF NOT EXISTS v1_version SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_version_app_id ON TABLE v1_version COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_extraction SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_extraction_app_id ON TABLE v1_extraction COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_evidence SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_evidence_app_id ON TABLE v1_evidence COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_turn SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_turn_app_id ON TABLE v1_turn COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_job SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_job_app_id ON TABLE v1_job COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_link SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_link_app_id ON TABLE v1_link COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_source_link SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_source_link_app_id ON TABLE v1_source_link COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_artifact SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_artifact_app_id ON TABLE v1_artifact COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_selection SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_selection_app_id ON TABLE v1_selection COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_import_report SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_import_report_app_id ON TABLE v1_import_report COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_connection SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_connection_app_id ON TABLE v1_connection COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_note_snapshot SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_note_snapshot_app_id ON TABLE v1_note_snapshot COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_export SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_export_app_id ON TABLE v1_export COLUMNS app_id UNIQUE;
DEFINE TABLE IF NOT EXISTS v1_legacy_chat SCHEMALESS;
DEFINE INDEX IF NOT EXISTS v1_legacy_chat_app_id ON TABLE v1_legacy_chat COLUMNS app_id UNIQUE;
