# NON-SECRET template. Store actual config and all four secret files outside checkout.
# Exact existing protected HTTPS public origin; no trailing slash or /api suffix.
# Required, intentionally blank. Production BFF rejects HTTP even on loopback.
PUBLIC_ORIGIN=
# Required absolute paths. Intentionally no placeholder credentials or file defaults.
DB_USER_FILE=
DB_PASSWORD_FILE=
ENCRYPTION_KEY_FILE=
ACCESS_PASSWORD_FILE=

# Required operator choice. The bundled db has no TLS; do NOT merely rename ws to wss.
# Use an actually provisioned TLS endpoint or explicitly accept plaintext for one endpoint.
SURREAL_URL=
# Optional exact plaintext endpoint exception, unsafe and intentionally blank by default.
SURREAL_INSECURE_ALLOW_URL=
