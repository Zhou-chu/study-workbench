{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDirs": [
      "../../..",
      "."
    ],
    "paths": {
      "~templates-utils": [
        "./templates-utils.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../../coverage-deployment.config.ts",
    "../../../examples/easypanel/index.ts",
    "../../../frontend/next.config.ts"
  ]
}
