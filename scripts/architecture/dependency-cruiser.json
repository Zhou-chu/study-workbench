{
  "forbidden": [
    {
      "name": "shared-no-app-or-platform",
      "severity": "error",
      "from": {
        "path": "^packages/(contracts|domain|web-transport)/src/"
      },
      "to": {
        "path": "^(?:apps/|frontend/|node:|@study/bff(?:$|/))|(?:^|node_modules/)(?:react|react-dom|next)(?:$|/)"
      }
    },
    {
      "name": "shared-no-node-builtins",
      "severity": "error",
      "from": {
        "path": "^packages/(contracts|domain|web-transport)/src/"
      },
      "to": {
        "dependencyTypes": [
          "core"
        ]
      }
    },
    {
      "name": "contracts-no-downstream-packages",
      "severity": "error",
      "from": {
        "path": "^packages/contracts/src/"
      },
      "to": {
        "path": "^packages/(domain|web-transport)/"
      }
    },
    {
      "name": "domain-no-transport",
      "severity": "error",
      "from": {
        "path": "^packages/domain/src/"
      },
      "to": {
        "path": "^packages/web-transport/"
      }
    },
    {
      "name": "modern-frontend-no-server-or-legacy",
      "severity": "error",
      "from": {
        "path": "^apps/web/src/"
      },
      "to": {
        "path": "^(?:apps/bff/|@study/bff(?:$|/)|frontend/)",
        "pathNot": "^frontend/src/lib/locales/"
      }
    },
    {
      "name": "bff-no-frontends",
      "severity": "error",
      "from": {
        "path": "^apps/bff/src/"
      },
      "to": {
        "path": "^(?:apps/web/|frontend/)"
      }
    },
    {
      "name": "no-unresolved-first-party-alias",
      "severity": "error",
      "from": {
        "path": "^(apps/(bff|web)/src|packages/[^/]+/src|frontend/src)/"
      },
      "to": {
        "couldNotResolve": true,
        "path": "^@(?:study/|/)"
      }
    },
    {
      "name": "no-first-party-cycles",
      "severity": "error",
      "from": {
        "path": "^(apps/(bff|web)/src|packages/[^/]+/src|frontend/src)/"
      },
      "to": {
        "circular": true,
        "path": "^(apps/(bff|web)/src|packages/[^/]+/src|frontend/src)/"
      }
    }
  ],
  "options": {
    "exclude": {
      "path": "(?:\\.(?:test|spec)\\.[cm]?[jt]sx?$|/(?:__tests__|test-utils|__mocks__)/)"
    },
    "doNotFollow": {
      "path": "node_modules"
    },
    "tsConfig": {
      "fileName": "scripts/architecture/tsconfig.json"
    },
    "tsPreCompilationDeps": true
  }
}
